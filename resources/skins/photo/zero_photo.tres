[gd_resource type="Resource" script_class="CharacterSkin" load_steps=5 format=3]

; The licensed render cut-outs, kept opt-in. They cannot be posed or lit to
; match a scene, so they are not the default -- but a private family build can
; point data/characters.json at this file instead of ../zero.tres.
; Do not ship a build containing this resource.

[ext_resource type="Script" path="res://scripts/skin/character_skin.gd" id="1"]
[ext_resource type="Texture2D" path="res://assets/characters/zero/hero_idle.png" id="2"]
[ext_resource type="Texture2D" path="res://assets/characters/zero/hero_cheer.png" id="3"]
[ext_resource type="Texture2D" path="res://assets/characters/zero/hero_portrait.png" id="4"]

[resource]
script = ExtResource("1")
id = "zero"
display_name_key = "character.zero"
prefer_texture = true
idle_texture = ExtResource("2")
cheer_texture = ExtResource("3")
portrait = ExtResource("4")
crest_kind = "horns"
chest_pattern = "blade"
body_color = Color(0.88, 0.9, 0.93, 1)
accent_color = Color(0.22, 0.42, 0.86, 1)
core_color = Color(0.4, 0.9, 1, 1)
core_offset = Vector2(-9, -100)
core_radius = 14.0
voice_dir = "res://assets/audio/voice/zero/"
body_size = Vector2(64, 96)
